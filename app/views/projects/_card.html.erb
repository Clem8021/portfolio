<div class="project-item reveal" data-reveal-target="item" data-reveal-delay="<%= local_assigns[:reveal_delay] || 0 %>">
 <div class="proj-visual">
    <%= image_tag "projects/#{project.image}", alt: project.title, class: "proj-img" %>
  </div>
  <div class="proj-info">
    <div class="proj-meta">
      <span class="proj-num"><%= project.position.to_s.rjust(2, "0") %></span>
      <span class="proj-year"><%= project.year %></span>
    </div>
    <h3 class="proj-title"><%= project.title %></h3>
    <p class="proj-tagline"><%= project.tagline %></p>
    <p class="proj-desc"><%= project.description %></p>
    <div class="proj-tags">
      <% project.technologies.split(", ").each do |tech| %>
        <span class="proj-tag"><%= tech %></span>
      <% end %>
    </div>
    <div class="proj-actions">
      <% if project.url.present? %>
        <%= link_to "Site en ligne ↗", project.url, class: "proj-link-ext", target: "_blank", rel: "noopener" %>
      <% end %>
    </div>
  </div>
</div>
