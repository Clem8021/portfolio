<section id="project-show">
  <div class="section-header">
    <span class="section-num"><%= @project.position.to_s.rjust(2, "0") %></span>
    <span class="section-title"><%= @project.category %></span>
  </div>

  <div class="proj-show-grid">
    <div class="proj-show-visual v-<%= @project.category %>">
      <span class="proj-visual-label"><%= @project.year %></span>
    </div>

    <div class="proj-show-info">
      <p class="proj-tagline"><%= @project.tagline %></p>
      <h1 class="proj-title"><%= @project.title %></h1>
      <p class="proj-desc"><%= @project.description %></p>

      <div class="proj-tags">
        <% @project.technologies.split(", ").each do |tech| %>
          <span class="proj-tag"><%= tech %></span>
        <% end %>
      </div>

      <div class="proj-actions">
        <% if @project.url.present? %>
          <%= link_to "Voir le site ↗", @project.url, class: "btn-cta-filled", target: "_blank", rel: "noopener" %>
        <% end %>
        <%= link_to "← Tous les projets", projects_path, class: "btn-cta" %>
      </div>
    </div>
  </div>
</section>